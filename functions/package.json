{
  "name": "erish-functions",
  "description": "ERISH Server-Side Commerce Engine, Razorpay Integration & Inventory Deductions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "razorpay": "^2.9.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.3.3"
  },
  "private": true
}

